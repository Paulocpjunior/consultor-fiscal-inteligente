rules_version = '2';

// Publicado automaticamente pelo workflow deploy-firestore.yml (push nesta
// arquivo aciona o deploy das rules + indexes). Não precisa mais de
// `firebase deploy` manual.

service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────────────────────────────────────────────
    // Helpers de role
    // ───────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwnerOrAdmin(userId) {
      return isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // ───────────────────────────────────────────────────────────────
    // users: admin le todos, user comum le so o proprio
    //        SO admin pode atualizar role de outros (anti-self-promotion)
    // ───────────────────────────────────────────────────────────────

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn()
        && request.auth.uid == userId
        // Perfil novo nao pode nascer com modulos restritos liberados
        && (!('modulosPermitidos' in request.resource.data)
            || request.resource.data.modulosPermitidos.size() == 0)
        && (
          // Perfil comum criado pelo proprio usuario nunca pode nascer admin.
          !('role' in request.resource.data)
          || request.resource.data.role == 'colaborador'
          // Excecao operacional existente: auto-seed do admin master.
          || (
            request.auth.token.email == 'junior@spassessoriacontabil.com.br'
            && request.auth.token.email_verified == true
            && request.resource.data.role == 'admin'
          )
        );

      // User pode atualizar proprio doc, MAS nao pode mudar a propria role
      // nem se auto-conceder modulos restritos (modulosPermitidos)
      allow update: if (
        // Admin pode mudar qualquer coisa
        isAdmin()
      ) || (
        // User pode atualizar proprio doc, sem mudar a propria role
        // nem a propria lista de modulos liberados
        request.auth.uid == userId
        && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
        && (!('modulosPermitidos' in request.resource.data)
            || request.resource.data.modulosPermitidos == resource.data.get('modulosPermitidos', []))
      );

      // Apenas admin pode deletar usuarios
      allow delete: if isAdmin();
    }

    // ───────────────────────────────────────────────────────────────
    // access_logs: admin le todos, user le so os proprios
    //              qualquer signed-in pode CRIAR (gravacao do proprio log)
    // ───────────────────────────────────────────────────────────────

    match /access_logs/{logId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid)
      );
      // Qualquer user logado pode gravar log do PROPRIO acesso
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Logs sao imutaveis
      allow update, delete: if isAdmin();
    }

    // ───────────────────────────────────────────────────────────────
    // simples_empresas, lucro_empresas, documentos_fiscais
    // Padrao: criador (createdBy) + admin
    // ───────────────────────────────────────────────────────────────

    match /simples_empresas/{empId} {
      // get: qualquer logado — colaboradores precisam ler empresas
      // atribuidas via carteira, nao apenas as que criaram.
      // list: qualquer logado com limite de query — o filtro por carteira
      // do colaborador e feito no codigo do app. Idealmente a carteira
      // seria denormalizada no documento da empresa para permitir
      // filtragem nas rules, mas isso exigiria refatoracao do modelo.
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 500;
      // update: qualquer logado, SEM mudar o dono. Antes era
      // isOwnerOrAdmin(createdBy) — colaborador da carteira que nao criou a
      // empresa tinha o update rejeitado (permission-denied), o service
      // engolia o erro e a apuracao "salva" sumia ao trocar de empresa
      // (caso Carlos Eduardo, 03/07). Filtro por carteira segue no app,
      // mesmo criterio do read acima. Doc legado sem createdBy segue editavel.
      allow update: if isSignedIn()
        && (!('createdBy' in resource.data)
            || request.resource.data.createdBy == resource.data.createdBy)
        // Lapide _deleted (soft-delete, caso WALDESA 24/07): SO admin pode
        // criar/alterar/remover — exclusao logica e exclusiva de admin, e
        // um save de cache velho de colaborador nao pode apagar a lapide.
        && (request.resource.data.get('_deleted', false) == resource.data.get('_deleted', false)
            || isAdmin());
      // delete: SO admin. Colaborador pode visualizar e editar, mas nao
      // excluir a empresa do cadastro. Antes era isOwnerOrAdmin, mas
      // colaborador que criou conseguia apagar — inconsistente com a UI
      // (Lucro/Simples ja escondem botao delete pra nao-admin) e perigoso.
      // (Hoje a exclusao e SOFT — lapide _deleted via update acima; o
      // deleteDoc fisico continua reservado a admin p/ limpeza definitiva.)
      allow delete: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
    }

    match /lucro_empresas/{empId} {
      // get: qualquer logado (colaboradores acessam via carteira).
      // list: limite de query para evitar download massivo.
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 500;
      // update: qualquer logado, sem mudar o dono nem a lapide _deleted
      // (ver simples_empresas).
      allow update: if isSignedIn()
        && (!('createdBy' in resource.data)
            || request.resource.data.createdBy == resource.data.createdBy)
        && (request.resource.data.get('_deleted', false) == resource.data.get('_deleted', false)
            || isAdmin());
      // delete: SO admin (ver comentario em simples_empresas).
      allow delete: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
    }

    match /documentos_fiscais/{docId} {
      // get: qualquer logado (colaboradores acessam via carteira).
      // list: limite de query para evitar download massivo.
      // 5000 cobre captura de NFSe SP via cron (319 empresas × ~10 NFs/mês).
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 5000;
      // UPDATE: qualquer signed-in pode atualizar (re-import PDF complementa
      // doc criado pelo cron, retag, marcar evento, etc). Bloqueia mudanca
      // de dono — preserva auditoria. Tambem libera caso a regra antiga
      // bloqueava import PDF de doc capturado por 'system:auto-sync'/cron.
      allow update: if isSignedIn() && (
        isAdmin() ||
        request.resource.data.createdBy == resource.data.createdBy
      );
      // DELETE: dono original ou admin (operacao destrutiva).
      allow delete: if isOwnerOrAdmin(resource.data.createdBy);
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
    }

    // ───────────────────────────────────────────────────────────────
    // simples_notas: notas do Simples gravadas como coleção TOP-LEVEL
    // (simplesNacionalService/cloudSync). Sem esta regra caía no
    // default-deny e TODA leitura/escrita retornava "Missing or
    // insufficient permissions" — o sync inicial falhava 100% (perda
    // silenciosa de dados). Mesmo padrão de documentos_fiscais.
    // ───────────────────────────────────────────────────────────────
    match /simples_notas/{notaId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 5000;
      allow update: if isSignedIn() && (
        isAdmin() ||
        request.resource.data.createdBy == resource.data.createdBy
      );
      allow delete: if isOwnerOrAdmin(resource.data.createdBy);
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
    }

    // ───────────────────────────────────────────────────────────────
    // carteiras: vinculo empresa <-> colaborador.
    // Leitura: qualquer logado (o filtro por colaborador e feito no
    //          codigo do app — admin ve tudo, colaborador so os seus).
    // Escrita: SO admin (so o admin atribui empresas a colaboradores).
    // ───────────────────────────────────────────────────────────────

    // carteira_observacoes: recado do colaborador sobre um cliente no mês.
    // NENHUM acesso pelo cliente — só o backend, que aplica o guard de
    // carteira (podeAcessarEmpresaId). As subcoleções de empresa liberam por
    // `createdBy`, e o colaborador da carteira quase nunca é quem cadastrou;
    // liberar aqui pra "qualquer logado" abriria a carteira inteira.
    match /carteira_observacoes/{obsId} {
      allow read, write: if false;
    }

    match /carteiras/{vinculoId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 500;
      allow create, update, delete: if isAdmin();
    }

    // ───────────────────────────────────────────────────────────────
    // Subcoleções comuns (notas, faturamento, etc) — herdam regras
    // do parent. Acesso por createdBy do parent ou admin.
    // ───────────────────────────────────────────────────────────────

    match /simples_empresas/{empId}/{subcoll}/{docId} {
      allow read, write: if isSignedIn() &&
        (isAdmin() ||
         get(/databases/$(database)/documents/simples_empresas/$(empId)).data.createdBy == request.auth.uid);
    }

    match /lucro_empresas/{empId}/{subcoll}/{docId} {
      allow read, write: if isSignedIn() &&
        (isAdmin() ||
         get(/databases/$(database)/documents/lucro_empresas/$(empId)).data.createdBy == request.auth.uid);
    }

    // ───────────────────────────────────────────────────────────────
    // Demais coleções operacionais (sefaz_*, manifestacoes_*, etc)
    // Apenas signed-in lê, apenas admin/backend escreve
    // ───────────────────────────────────────────────────────────────

    match /sefaz_certificados/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /sefaz_certificados_historico/{docId} {
      allow read, write: if isAdmin();
    }

    // Cadastro dos fornecedores produtores rurais (base da DIPAM 1.1 e da
    // sub-rogação do FUNRURAL). Colaborador LÊ (a tela mostra o que já foi
    // confirmado no CADESP); só admin/backend GRAVA — confirmar natureza
    // jurídica errada muda o que vai declarado na EFD e na GIA.
    match /produtores_rurais/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /manifestacoes_log/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /manifestacoes_cron_logs/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    // MODELO SHARED-WRITE (categorias_fornecedor, empresa_credito_config,
    // fornecedores_ocultos, notas_ocultas, invoices_manuais,
    // categorias_credito_custom)
    //
    // ⚠ NÃO "endureça" essas regras pra createdBy/uid achando que é
    //   vazamento multi-tenant — o produto é SINGLE-TENANT (um escritório,
    //   S&P, com admin + colaboradores; sem conceito de organização). O
    //   write aberto a qualquer signed-in é INTENCIONAL: qualquer
    //   colaborador classifica fornecedor, oculta/desoculta nota, etc.
    //
    // ⚠ DELETE é fluxo NORMAL de colaborador em fornecedores_ocultos,
    //   notas_ocultas e invoices_manuais (desocultar = deletar o doc;
    //   remover invoice manual). Restringir delete a admin QUEBRA a UI.
    //
    // ⚠ empresa_credito_config usa o empresaId como docId e NÃO carrega
    //   empresaId no corpo — uma regra exigindo request.resource.data.empresaId
    //   quebraria a gravação. Idem campos de autor: categorias_fornecedor usa
    //   `atualizadoPor`, as ocultas usam `criadoPor` — não há campo único.
    //
    // Se um dia o produto virar multi-tenant, o caminho seguro é primeiro
    // padronizar os payloads dos services (empresaId + autor) e SÓ DEPOIS
    // gatear aqui — senão quebra o app em produção.
    // ═══════════════════════════════════════════════════════════════

    // ───────────────────────────────────────────────────────────────
    // categorias_fornecedor: tabela CNPJ -> categoria por empresa.
    // Leitura e escrita para QUALQUER usuario logado — todos os
    // colaboradores podem corrigir/cadastrar a categoria de um fornecedor.
    // ───────────────────────────────────────────────────────────────

    match /categorias_fornecedor/{regraId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 1000;
      allow write: if isSignedIn();
    }

    // De→Para de códigos de participante do E-Fiscal (Exportar SAGE) — um doc
    // por empresa. Shared-write: quem opera a exportação é o colaborador e o
    // ciclo (gerar → log de erros → mapear código → regerar) não pode esperar
    // admin. Alimentado pelo leitor do log em Exportar SAGE (IOB).
    match /sage_codigos_participantes/{empresaId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 1000;
      allow write: if isSignedIn();
    }

    // ───────────────────────────────────────────────────────────────
    // empresa_credito_config: config de credito PIS/COFINS por empresa.
    // Armazena lista de categorias marcadas como "nao gera credito" pra
    // aquela empresa-cliente. Doc ID = empresaId.
    // Leitura e escrita para QUALQUER usuario logado (mesmo padrao das
    // categorias — todos os colaboradores podem ajustar).
    // ───────────────────────────────────────────────────────────────

    match /empresa_credito_config/{empresaId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 1000;
      allow write: if isSignedIn();
    }

    // ───────────────────────────────────────────────────────────────
    // fornecedores_ocultos: regras "ignorar esse fornecedor pra essa
    // empresa para sempre" no calculo de credito PIS/COFINS.
    // Doc ID = `${empresaId}__${cnpjDigitos}`.
    // Leitura e escrita para qualquer usuario logado (mesmo padrao das
    // outras regras de classificacao).
    // ───────────────────────────────────────────────────────────────

    match /fornecedores_ocultos/{regraId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 1000;
      allow write: if isSignedIn();
    }

    // ───────────────────────────────────────────────────────────────
    // notas_ocultas: granularidade FINA — oculta UMA NF especifica
    // por (CNPJ, numero, serie). Diferente de fornecedores_ocultos
    // (que oculta todas NFs do CNPJ).
    // Doc ID = `${empresaId}__${chaveNfSanitizada}`.
    // ───────────────────────────────────────────────────────────────

    match /notas_ocultas/{regraId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 1000;
      allow write: if isSignedIn();
    }

    // ───────────────────────────────────────────────────────────────
    // invoices_manuais: invoices lancadas manualmente, por empresa+periodo.
    // Leitura e escrita para QUALQUER usuario logado.
    // ───────────────────────────────────────────────────────────────

    match /invoices_manuais/{invoiceId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 1000;
      allow write: if isSignedIn();
    }

    // ───────────────────────────────────────────────────────────────
    // categorias_credito_custom: categorias customizadas (alem das 11 da IA).
    // Leitura e escrita para QUALQUER usuario logado.
    // ───────────────────────────────────────────────────────────────

    match /categorias_credito_custom/{catId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 1000;
      allow write: if isSignedIn();
    }

    // ───────────────────────────────────────────────────────────────
    // tarefas: gestao de tarefas/prazos.
    // Leitura, criacao e update para QUALQUER signed-in (colaborador
    // marca concluida, etc). Delete apenas admin.
    // ───────────────────────────────────────────────────────────────

    match /tarefas/{tarefaId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 1000;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Logs do cron: leitura admin, escrita soh backend (regra firme)
    match /tarefas_cron_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ───────────────────────────────────────────────────────────────
    // xml_capturas: log de capturas XML — append-only para usuarios
    // comuns, admin le/escreve tudo.
    // ───────────────────────────────────────────────────────────────

    match /xml_capturas/{logId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.usuarioId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.usuarioId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ───────────────────────────────────────────────────────────────
    // xml_erros: erros de importacao XML — usuario pode marcar como
    // resolvido o seu proprio, admin gerencia todos.
    // ───────────────────────────────────────────────────────────────

    match /xml_erros/{errId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.usuarioId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.usuarioId == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && resource.data.usuarioId == request.auth.uid && request.resource.data.usuarioId == resource.data.usuarioId);
      allow delete: if isAdmin();
    }

    // ───────────────────────────────────────────────────────────────
    // empresas_xml_config: configuracoes XML por empresa
    // (monitoramento, agendamento).
    // ───────────────────────────────────────────────────────────────

    match /empresas_xml_config/{configId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 1000;
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ─── Coleções operacionais (escritas pelo backend via admin SDK,
    //     leitura no frontend por qualquer signed-in) ─────────────────

    match /caixa_postal_mensagens/{docId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 1000;
      allow write: if false;
    }

    match /das_emitidos/{docId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 1000;
      allow write: if false;
    }

    // pgdas_atividades_codigos: codigo oficial de atividade do PGDAS-D
    // (ISS fixo/SUP). Vai NA DECLARACAO ao SERPRO — leitura e escrita passam
    // SO pelo backend, que valida o numero contra a declaracao lida.
    match /pgdas_atividades_codigos/{docId} {
      allow read, write: if false;
    }

    // dare_codigos_servico: codigo de servico DARE que nao e tabela fixa —
    // hoje a antecipacao do art. 426-A (rubrica propria). So o backend le e
    // grava, e ele valida contra a lista real da SEFAZ: codigo de tributo
    // errado poe o dinheiro na receita errada e a SEFAZ nao desfaz emissao.
    match /dare_codigos_servico/{docId} {
      allow read, write: if false;
    }

    // ncm_parametros: cadastro de NCM (aliquota interna, IVA-ST, CEST).
    // Leitura liberada a quem esta logado — a tela consulta direto; ESCRITA
    // so pelo backend, que valida (IVA-ST sem Portaria e aliquota fora da
    // faixa sao recusados la).
    match /ncm_parametros/{docId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 1000;
      allow write: if false;
    }

    // nfts_codigos_recusados: codigos que a PMSP recusou (erro 310) DEPOIS do
    // ultimo deploy. Leitura por quem esta logado — a tela de NFTS soma esta
    // lista a fixa antes de validar o lote. ESCRITA so admin: bloquear um
    // codigo por engano derruba a importacao de todo mundo.
    match /nfts_codigos_recusados/{docId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 1000;
      allow write: if isAdmin();
    }

    match /nfse_nacional_emitidas/{docId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 1000;
      allow write: if false;
    }

    match /dctfweb_declaracoes/{docId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 1000;
      allow write: if false;
    }

    match /darf_emitidos/{docId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 1000;
      allow write: if false;
    }

    match /notificacoes/{docId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 1000;
      allow write: if false;
    }

    match /sharepoint_sync_log/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ───────────────────────────────────────────────────────────────
    // sped_arquivos: histórico de importações SPED.
    // Criador + admin leem/escrevem.
    // ───────────────────────────────────────────────────────────────

    match /sped_arquivos/{docId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 500;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ───────────────────────────────────────────────────────────────
    // sped_ajustes_apuracao: ajustes do E111 (apuração ICMS) por
    // empresa × competência. Lançar ajuste é trabalho da equipe
    // (mesmo padrão do gia_st_guias); exclusão só admin.
    // ───────────────────────────────────────────────────────────────

    match /contadores/{docId} {
      // Catálogo de contadores do escritório (03/08): equipe cadastra e
      // escolhe por empresa; exclusão só admin.
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 500;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /sped_ajustes_apuracao/{docId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 500;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // sped_ciap_bens: CIAP / Bloco G — bens do ativo imobilizado com o crédito
    // de ICMS em 48 parcelas. 1 doc por EMPRESA (não por competência: o bem
    // atravessa 4 anos). Manutenção é da equipe; exclusão só admin.
    match /sped_ciap_bens/{docId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 500;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // sped_inventario: contagem física do Bloco H (H005/H010). 1 doc por
    // EMPRESA × DATA do inventário — o inventário é uma FOTO de uma data, não
    // de uma competência. Dado que só existe fora do sistema (contagem do
    // cliente): sem ele o bloco sai VAZIO, nunca zerado.
    match /sped_inventario/{docId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 500;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ───────────────────────────────────────────────────────────────
    // gia_st_guias: GIA-ST (ICMS-ST) por CNPJ × UF favorecida × mês.
    // Colaborador cria/atualiza; exclusão só admin (mesmo padrão do
    // sped_arquivos — guia salva é registro de apuração).
    // ───────────────────────────────────────────────────────────────

    match /gia_st_guias/{docId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 500;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // nfp_analises: analises de compliance tributario (NFP Pro Cloud).
    // Leitura para qualquer signed-in, escrita para signed-in, delete apenas admin.

    match /nfp_analises/{docId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 500;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ───────────────────────────────────────────────────────────────
    // Módulo Legalização (departamento de legalização/societário).
    // legalizacao_vencimentos: espelho dos formulários Jotform (certidões,
    //   certificados digitais, parcelamentos) — SÓ o backend escreve (sync).
    // legalizacao_processos: processos do departamento (abertura, alteração,
    //   encerramento, contrato, procuração, regularização...) — colaborador
    //   cria/edita, exclusão só admin (mesmo padrão gia_st_guias).
    // legalizacao_alertas: auditoria dos alertas enviados — só backend.
    // legalizacao_cron_logs: log das corridas do cron — só admin lê.
    // ───────────────────────────────────────────────────────────────

    match /legalizacao_vencimentos/{docId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 1000;
      allow write: if false;
    }

    match /legalizacao_processos/{docId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 1000;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /legalizacao_alertas/{docId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 1000;
      allow write: if false;
    }

    match /legalizacao_cron_logs/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ───────────────────────────────────────────────────────────────
    // Default deny: qualquer coleção não listada acima é negada.
    // ───────────────────────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
