rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────────────────────────────────────────────
    // Helpers de role
    // ───────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwnerOrAdmin(userId) {
      return isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // ───────────────────────────────────────────────────────────────
    // users: admin le todos, user comum le so o proprio
    //        SO admin pode atualizar role de outros (anti-self-promotion)
    // ───────────────────────────────────────────────────────────────

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;

      // User pode atualizar proprio doc, MAS nao pode mudar a propria role
      allow update: if (
        // Admin pode mudar qualquer coisa
        isAdmin()
      ) || (
        // User pode atualizar proprio doc, sem mudar a propria role
        request.auth.uid == userId
        && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
      );

      // Apenas admin pode deletar usuarios
      allow delete: if isAdmin();
    }

    // ───────────────────────────────────────────────────────────────
    // access_logs: admin le todos, user le so os proprios
    //              qualquer signed-in pode CRIAR (gravacao do proprio log)
    // ───────────────────────────────────────────────────────────────

    match /access_logs/{logId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid)
      );
      // Qualquer user logado pode gravar log do PROPRIO acesso
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Logs sao imutaveis
      allow update, delete: if isAdmin();
    }

    // ───────────────────────────────────────────────────────────────
    // simples_empresas, lucro_empresas, documentos_fiscais
    // Padrao: criador (createdBy) + admin
    // ───────────────────────────────────────────────────────────────

    match /simples_empresas/{empId} {
      // get (1 doc): so dono ou admin. list (query): qualquer logado —
      // o filtro por carteira do colaborador e garantido pelo codigo do app.
      allow get: if isOwnerOrAdmin(resource.data.createdBy);
      allow list: if isSignedIn();
      allow update, delete: if isOwnerOrAdmin(resource.data.createdBy);
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
    }

    match /lucro_empresas/{empId} {
      allow get: if isOwnerOrAdmin(resource.data.createdBy);
      allow list: if isSignedIn();
      allow update, delete: if isOwnerOrAdmin(resource.data.createdBy);
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
    }

    match /documentos_fiscais/{docId} {
      allow get: if isOwnerOrAdmin(resource.data.createdBy);
      allow list: if isSignedIn();
      allow update, delete: if isOwnerOrAdmin(resource.data.createdBy);
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
    }

    // ───────────────────────────────────────────────────────────────
    // carteiras: vinculo empresa <-> colaborador.
    // Leitura: qualquer logado (o filtro por colaborador e feito no
    //          codigo do app — admin ve tudo, colaborador so os seus).
    // Escrita: SO admin (so o admin atribui empresas a colaboradores).
    // ───────────────────────────────────────────────────────────────

    match /carteiras/{vinculoId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ───────────────────────────────────────────────────────────────
    // Subcoleções comuns (notas, faturamento, etc) — herdam regras
    // do parent. Acesso por createdBy do parent ou admin.
    // ───────────────────────────────────────────────────────────────

    match /simples_empresas/{empId}/{subcoll}/{docId} {
      allow read, write: if isSignedIn() &&
        (isAdmin() ||
         get(/databases/$(database)/documents/simples_empresas/$(empId)).data.createdBy == request.auth.uid);
    }

    match /lucro_empresas/{empId}/{subcoll}/{docId} {
      allow read, write: if isSignedIn() &&
        (isAdmin() ||
         get(/databases/$(database)/documents/lucro_empresas/$(empId)).data.createdBy == request.auth.uid);
    }

    // ───────────────────────────────────────────────────────────────
    // Demais coleções operacionais (sefaz_*, manifestacoes_*, etc)
    // Apenas signed-in lê, apenas admin/backend escreve
    // ───────────────────────────────────────────────────────────────

    match /sefaz_certificados/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /sefaz_certificados_historico/{docId} {
      allow read, write: if isAdmin();
    }

    match /manifestacoes_log/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /manifestacoes_cron_logs/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ───────────────────────────────────────────────────────────────
    // categorias_fornecedor: tabela CNPJ -> categoria por empresa.
    // Leitura e escrita para QUALQUER usuario logado — todos os
    // colaboradores podem corrigir/cadastrar a categoria de um fornecedor.
    // ───────────────────────────────────────────────────────────────

    match /categorias_fornecedor/{regraId} {
      allow read, write: if isSignedIn();
    }

    // ───────────────────────────────────────────────────────────────
    // empresa_credito_config: config de credito PIS/COFINS por empresa.
    // Armazena lista de categorias marcadas como "nao gera credito" pra
    // aquela empresa-cliente. Doc ID = empresaId.
    // Leitura e escrita para QUALQUER usuario logado (mesmo padrao das
    // categorias — todos os colaboradores podem ajustar).
    // ───────────────────────────────────────────────────────────────

    match /empresa_credito_config/{empresaId} {
      allow read, write: if isSignedIn();
    }

    // ───────────────────────────────────────────────────────────────
    // invoices_manuais: invoices lancadas manualmente, por empresa+periodo.
    // Leitura e escrita para QUALQUER usuario logado.
    // ───────────────────────────────────────────────────────────────

    match /invoices_manuais/{invoiceId} {
      allow read, write: if isSignedIn();
    }

    // ───────────────────────────────────────────────────────────────
    // categorias_credito_custom: categorias customizadas (alem das 11 da IA).
    // Leitura e escrita para QUALQUER usuario logado.
    // ───────────────────────────────────────────────────────────────

    match /categorias_credito_custom/{catId} {
      allow read, write: if isSignedIn();
    }

    // ───────────────────────────────────────────────────────────────
    // tarefas: gestao de tarefas/prazos.
    // Leitura, criacao e update para QUALQUER signed-in (colaborador
    // marca concluida, etc). Delete apenas admin.
    // ───────────────────────────────────────────────────────────────

    match /tarefas/{tarefaId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Logs do cron: leitura admin, escrita soh backend (regra firme)
    match /tarefas_cron_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ───────────────────────────────────────────────────────────────
    // Default deny: qualquer coleção não listada acima é negada.
    // ───────────────────────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
