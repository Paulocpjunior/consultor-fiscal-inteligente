# Chave da API do Google Gemini (obrigatória para IA)
VITE_GEMINI_API_KEY=

# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend Gemini API key (server-side, Cloud Run)
GEMINI_API_KEY=

# Microsoft Graph API (SharePoint integration)
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=
SHAREPOINT_SITE_URL=

# URL do proxy backend (opcional, para modo proxy seguro)
# VITE_API_PROXY_URL=http://localhost:8080

# Dados do Contador (SPED Fiscal)
CONTADOR_NOME=
CONTADOR_CPF=
CONTADOR_CNPJ=
CONTADOR_CRC=
CONTADOR_ENDERECO=
CONTADOR_BAIRRO=
CONTADOR_CIDADE=
CONTADOR_UF=
CONTADOR_CEP=
CONTADOR_TELEFONE=
CONTADOR_EMAIL=

# Email remetente de notificacoes
NOTIF_REMETENTE_EMAIL=
# CNPJ do escritorio contabil (NFS-e SP)
NFSE_SP_REMETENTE_CNPJ=
