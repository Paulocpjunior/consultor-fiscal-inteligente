# Chave da API do Google Gemini (obrigatória para IA)
VITE_GEMINI_API_KEY=

# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─── Visibilidade temporaria do escritorio ────────────────────────────────────
# Quando "1", colaboradores (nao-admin) veem TODAS as empresas/notas/documentos,
# ignorando a Carteira de Clientes. Configure como Repository Variable
# `VITE_VISIBILIDADE_ABERTA=1` no GitHub Actions. Use enquanto a carteira
# nao esta 100% atribuida -- ao concluir, deixe vazio ou "0" pra restaurar
# o filtro por carteira+createdBy. Issue #104 eh a solucao definitiva.
# definitiva; esta flag eh um stop-gap.
VITE_VISIBILIDADE_ABERTA=

# Backend Gemini API key (server-side, Cloud Run)
GEMINI_API_KEY=

# Microsoft Graph API (SharePoint integration)
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=
SHAREPOINT_SITE_URL=

# URL do proxy backend (opcional, para modo proxy seguro)
# VITE_API_PROXY_URL=http://localhost:8080

# CORS origin override (opcional, para dominios custom)
# CORS_ORIGIN=https://meu-dominio.com

# Dados do Contador (SPED Fiscal)
CONTADOR_NOME=
CONTADOR_CPF=
CONTADOR_CNPJ=
CONTADOR_CRC=
CONTADOR_ENDERECO=
CONTADOR_BAIRRO=
CONTADOR_CIDADE=
CONTADOR_UF=
CONTADOR_CEP=
CONTADOR_TELEFONE=
CONTADOR_EMAIL=

# Email remetente de notificacoes
NOTIF_REMETENTE_EMAIL=
# CNPJ do escritorio contabil (NFS-e SP)
NFSE_SP_REMETENTE_CNPJ=

# ─── Observabilidade (Sentry frontend + backend) ───────────────────────────────
# Sem DSN, sentry vira NO-OP (sem telemetria, app roda normalmente).
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=development

# ─── Cron / SEFAZ ──────────────────────────────────────────────────────────────
# Segredo compartilhado entre Cloud Scheduler e o backend.
SEFAZ_CRON_SECRET=

# ─── SERPRO (DARF/DAS/DCTFWeb) ────────────────────────────────────────────────
# Quando vazio o app usa motor MOCK; cuidado pra nao subir em prod sem set.
SERPRO_CONSUMER_KEY=
SERPRO_CONSUMER_SECRET=
DAS_MODE=mock              # mock | serpro
DARF_MODE=mock             # mock | serpro
DCTFWEB_MODE=mock          # mock | serpro

# ─── NFS-e Nacional (modulo de emissao) ───────────────────────────────────────
# Quando "1", bloqueia emissao real em prod (modo soft-launch).
EMISSAO_BLOQUEADA=0
# Ambiente do servico nacional: producao | homologacao
NFSE_NAC_EMISSAO_AMB=homologacao

# ─── Reforma Tributaria (banner CBS/IBS) ──────────────────────────────────────
# Data ISO do marco. Default 2026-08-01. Atualizar se o cronograma mudar.
VITE_REFORMA_CBS_IBS_DATE=2026-08-01

# ─── Modo local (auth offline - SO dev local) ─────────────────────────────────
# Ativa fluxo de auth via localStorage (sem Firebase). NUNCA em prod.
# VITE_AUTH_LOCAL_MODE=1
# Senha do master admin no modo local. Sem default por seguranca.
# VITE_AUTH_LOCAL_MASTER_PASSWORD=
